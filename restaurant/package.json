		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.3.0",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"sass": "^1.70.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
