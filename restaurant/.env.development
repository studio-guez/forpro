# KIRBY CMS
# Handles content management.
# `cms.localhost` works from both the browser (resolves to 127.0.0.1) and from
# inside the SvelteKit container (resolved to the Docker host via the
# `extra_hosts: cms.localhost:host-gateway` mapping in compose.dev.yml).
# In both cases the request hits Traefik on port 80 which routes it to the cms service.
PUBLIC_CMS_BASE_URL='http://cms.localhost'

# MENU (Nuxt)
# Daily menus screens app.
PUBLIC_MENU_BASE_URL='http://menu.localhost'
