# Seeded to $DEPLOY_PATH/shared/deploy.env on the first deploy; edit it there, never commit the real file.
# The {CMS,WEBSITE,RESTAURANT,MENU}_HTTP_PORT GitHub Actions variables override these per environment.
# Keep BIND_ADDRESS at 127.0.0.1 unless the reverse proxy is on another host; never 0.0.0.0.

BIND_ADDRESS=127.0.0.1

CMS_HTTP_PORT=8080
WEBSITE_HTTP_PORT=8081
RESTAURANT_HTTP_PORT=8082
MENU_HTTP_PORT=8083
