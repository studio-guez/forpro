# Per-server deployment settings.
#
# Seeded to $DEPLOY_PATH/shared/deploy.env on the first deploy; edit it there
# if a port collides with something else on the server, then re-deploy (or run
# `docker compose ... up -d` manually). Never commit the real file to git.
#
# Each service is published only on 127.0.0.1 — the host-level nginx forwards
# the public domains to these loopback ports.

CMS_HTTP_PORT=8080
WEBSITE_HTTP_PORT=8081
RESTAURANT_HTTP_PORT=8082
MENU_HTTP_PORT=8083
