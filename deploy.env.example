# Per-server deployment settings.
#
# Seeded to $DEPLOY_PATH/shared/deploy.env on the first deploy; edit it there
# if a port collides with something else on the server, then re-deploy (or run
# `docker compose ... up -d` manually). Never commit the real file to git.
#
# These values can also be set per environment with the
# {CMS,WEBSITE,RESTAURANT,MENU}_HTTP_PORT GitHub Actions variables: the deploy
# action then writes them into this file and uses them for the stack. Required
# when preproduction and production share a host, since the defaults collide.
#
# Each service is published on BIND_ADDRESS only. Keep 127.0.0.1 when the
# reverse proxy (nginx) runs on the same host; set the server's private IP
# (e.g. BIND_ADDRESS=10.100.0.241) when the proxy is on another machine and
# has to reach these ports over the network. Never bind to 0.0.0.0.

BIND_ADDRESS=127.0.0.1

CMS_HTTP_PORT=8080
WEBSITE_HTTP_PORT=8081
RESTAURANT_HTTP_PORT=8082
MENU_HTTP_PORT=8083

# HTTP Basic auth for website, restaurant and menu — one credential for the
# three of them. Meant to keep preprod off the public web, not to protect
# anything sensitive: it is stored in clear here and the apps compare it as-is.
# Set it on preprod (then re-deploy, or `docker compose ... up -d`), leave it
# empty on production, where the check is skipped entirely.
# The /health endpoints stay open so the container healthchecks keep passing.
# The CMS is not covered: Kirby has its own Panel login.
BASIC_AUTH=
