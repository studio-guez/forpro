FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./

RUN pnpm install

COPY . .

# SvelteKit inlines PUBLIC_* env vars at build time, so these are deliberately
# left without defaults: the values come from the PREPROD_*/PRODUCTION_*
# repository variables in CI, and a missing one must fail rather than silently
# bake another environment's URL into the bundle.
# PUBLIC_ENVIRONMENT is 'preprod' or 'production'; 'preprod' disables indexing
# (noindex + robots.txt disallow) and Matomo.
ARG PUBLIC_CMS_BASE_URL
ARG PUBLIC_ENVIRONMENT
ENV PUBLIC_CMS_BASE_URL=$PUBLIC_CMS_BASE_URL \
    PUBLIC_ENVIRONMENT=$PUBLIC_ENVIRONMENT

RUN [ -n "$PUBLIC_CMS_BASE_URL" ] && [ -n "$PUBLIC_ENVIRONMENT" ] \
      || { echo "Missing build arg: PUBLIC_CMS_BASE_URL / PUBLIC_ENVIRONMENT" >&2; exit 1; } \
    && pnpm run build

FROM node:24-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

USER node:node

WORKDIR /app

COPY --from=builder --chown=node:node /app/build ./build
COPY --from=builder --chown=node:node /app/node_modules ./node_modules

COPY --chown=node:node package.json pnpm-lock.yaml* ./

CMD ["node", "build"]