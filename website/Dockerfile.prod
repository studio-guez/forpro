FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./

RUN pnpm install

COPY . .

# SvelteKit inlines PUBLIC_* env vars at build time. Real environment
# variables take precedence over .env.production, so CI can override the
# committed defaults per deployment target (e.g. preprod domains).
ARG PUBLIC_CMS_BASE_URL=https://api.for-pro.ch
ENV PUBLIC_CMS_BASE_URL=$PUBLIC_CMS_BASE_URL

RUN pnpm run build

FROM node:24-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

USER node:node

WORKDIR /app

COPY --from=builder --chown=node:node /app/build ./build
COPY --from=builder --chown=node:node /app/node_modules ./node_modules

COPY --chown=node:node package.json pnpm-lock.yaml* ./

CMD ["node", "build"]