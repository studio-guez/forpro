### FRONTENDS ===========================================================================================================

.DS_Store

# website (SvelteKit)
website/node_modules
website/build
website/.svelte-kit
website/package
website/vite.config.js.timestamp-*
website/vite.config.ts.timestamp-*

# restaurant (SvelteKit)
restaurant/node_modules
restaurant/build
