### CMS ================================================================================================================

# Temporary files
cms/media/*
cms/**/media/index.html

# Lock files
cms/.lock

# -------------SECURITY-------------
# NEVER publish these files via Git!
# -------------SECURITY-------------

# Cache Files
cms/site/cache/*
cms/**/site/cache/index.html

# Accounts
cms/site/accounts/*
cms/**/site/accounts/index.html

# Sessions
cms/site/sessions/*
cms/**/site/sessions/index.html

# License
cms/site/config/.license

# Environment files with secrets (use cms/.env.example as template)
cms/.env

# Content
cms/content

# Kirby core & composer vendor (baked into Docker image, not tracked in git)
cms/kirby/
cms/vendor/

# NODE
cms/site/plugins/**/node_modules/*

# DATA PLUGINS
cms/site/plugins/**/data/*

