FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# The app is a SPA (`ssr: false`), so the public runtime config is baked in at build time.
ARG NUXT_PUBLIC_CMS_BASE_URL=https://api.for-pro.ch
# 'preprod' disables indexing (noindex + robots.txt disallow).
ARG NUXT_PUBLIC_ENVIRONMENT=production
ENV NUXT_PUBLIC_CMS_BASE_URL=$NUXT_PUBLIC_CMS_BASE_URL
ENV NUXT_PUBLIC_ENVIRONMENT=$NUXT_PUBLIC_ENVIRONMENT
ENV NUXT_TELEMETRY_DISABLED=1

RUN pnpm run build

FROM node:24-alpine

USER node:node

WORKDIR /app

COPY --from=builder --chown=node:node /app/.output ./.output

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["node", ".output/server/index.mjs"]
