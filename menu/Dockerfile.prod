FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# The app is a SPA (`ssr: false`), so the public runtime config is baked in at
# build time. No defaults: the values come from the PREPROD_*/PRODUCTION_*
# repository variables in CI, and a missing one must fail rather than silently
# bake another environment's URL into the bundle.
# NUXT_PUBLIC_ENVIRONMENT is 'preprod' or 'production'; 'preprod' disables
# indexing (noindex + robots.txt disallow).
ARG NUXT_PUBLIC_CMS_BASE_URL
ARG NUXT_PUBLIC_ENVIRONMENT
ENV NUXT_PUBLIC_CMS_BASE_URL=$NUXT_PUBLIC_CMS_BASE_URL
ENV NUXT_PUBLIC_ENVIRONMENT=$NUXT_PUBLIC_ENVIRONMENT
ENV NUXT_TELEMETRY_DISABLED=1

RUN [ -n "$NUXT_PUBLIC_CMS_BASE_URL" ] && [ -n "$NUXT_PUBLIC_ENVIRONMENT" ] \
      || { echo "Missing build arg: NUXT_PUBLIC_CMS_BASE_URL / NUXT_PUBLIC_ENVIRONMENT" >&2; exit 1; } \
    && pnpm run build

FROM node:24-alpine

USER node:node

WORKDIR /app

COPY --from=builder --chown=node:node /app/.output ./.output

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["node", ".output/server/index.mjs"]
