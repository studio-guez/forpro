FROM node:24-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# No defaults on purpose: a missing PREPROD_*/PRODUCTION_* CI variable must fail the build rather than bake another environment's URL.
ARG NUXT_PUBLIC_CMS_BASE_URL
ARG NUXT_PUBLIC_ENVIRONMENT
ENV NUXT_PUBLIC_CMS_BASE_URL=$NUXT_PUBLIC_CMS_BASE_URL
ENV NUXT_PUBLIC_ENVIRONMENT=$NUXT_PUBLIC_ENVIRONMENT
ENV NUXT_TELEMETRY_DISABLED=1

RUN [ -n "$NUXT_PUBLIC_CMS_BASE_URL" ] && [ -n "$NUXT_PUBLIC_ENVIRONMENT" ] \
      || { echo "Missing build arg: NUXT_PUBLIC_CMS_BASE_URL / NUXT_PUBLIC_ENVIRONMENT" >&2; exit 1; } \
    && pnpm run build

FROM node:24-alpine

USER node:node

WORKDIR /app

COPY --from=builder --chown=node:node /app/.output ./.output

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["node", ".output/server/index.mjs"]
