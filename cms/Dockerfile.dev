FROM php:8.4-apache

# Arguments for user mapping (local dev)
ARG UID=1000
ARG GID=1000

ENV TZ=Europe/Zurich

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Activer mod_rewrite pour Kirby
RUN a2enmod rewrite

# Installer dépendances système + extensions PHP
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    libzip-dev \
    libicu-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" zip gd intl opcache \
    && rm -rf /var/lib/apt/lists/*

# Installe Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Ajouter un ServerName pour éviter les logs
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# Activer config Apache custom
COPY apache.conf /etc/apache2/conf-available/custom.conf
RUN a2enconf custom

# Modify www-data user to match host user UID/GID
RUN usermod -u $UID www-data && groupmod -g $GID www-data

# Set Apache to run as www-data (which now has your UID/GID)
ENV APACHE_RUN_USER=www-data
ENV APACHE_RUN_GROUP=www-data

# Appliquer la config PHP custom (memory_limit, upload_max_filesize, ...)
COPY php.ini /usr/local/etc/php/conf.d/zz-custom.ini

# Development php.ini: verbose errors
RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"

RUN rm -rf /var/www/html/*

WORKDIR /var/www/html
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader

# In dev, content, site/*, utils and index.php are bind-mounted from the host
# (see compose.dev.yml), so they are not baked into the image.
RUN rm -rf /var/www/html/content

# Use the version-controlled .htaccess (front-controller rewrites + rules that
# block direct access to content, site and kirby sources).
COPY .htaccess /var/www/html/.htaccess

RUN mkdir -p /var/www/html/site/sessions \
    /var/www/html/site/accounts \
    /var/www/html/site/plugins \
    /var/www/html/site/cache \
    /var/www/html/media

RUN chown -R www-data:www-data /var/www/html/

RUN apache2ctl configtest

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

CMD ["/entrypoint.sh"]
