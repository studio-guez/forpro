# On the servers the real file is $DEPLOY_PATH/shared/cms.env, seeded from this example on first deploy.

KIRBY_DEBUG=false
KIRBY_VUE_COMPILER=false
KIRBY_ROBOTS_INDEX=true
KIRBY_FRONTEND_URL=https://for-pro.ch
# Pins the base of media/file URLs so they stay browser-resolvable when the frontends fetch over the internal Docker network; empty = auto-detect.
KIRBY_URL=https://api.for-pro.ch
# Changing the salt breaks existing encrypted content.
KIRBY_CONTENT_SALT=replace-with-random-value
KIRBY_COOKIE_KEY=replace-with-random-value

# Prod: e.g. host=mail.infomaniak.com, port=465, security=true, auth=true.
KIRBY_SMTP_HOST=mailpit
KIRBY_SMTP_PORT=1025
KIRBY_SMTP_SECURITY=false
KIRBY_SMTP_AUTH=false
KIRBY_SMTP_USERNAME=
KIRBY_SMTP_PASSWORD=