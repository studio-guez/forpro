# Copy this file to .env.development and .env.production and fill in real values.
# Both are gitignored (they hold secrets) and excluded from rsync deploys.

# true in development, false in production
KIRBY_DEBUG=false
# Panel Vue template compiler — true only when developing panel plugins
KIRBY_VUE_COMPILER=false
# Public site URL used for SEO canonical base + root redirect
KIRBY_FRONTEND_URL=https://for-pro.ch
# Secrets — random values, keep stable (changing the salt breaks encrypted content)
KIRBY_CONTENT_SALT=replace-with-random-value
KIRBY_COOKIE_KEY=replace-with-random-value

# SMTP transport for outgoing mail.
# Dev: point at Mailpit (host=mailpit, port=1025, security/auth=false, no credentials).
# Prod: real SMTP server (e.g. host=mail.infomaniak.com, port=465, security=true, auth=true).
KIRBY_SMTP_HOST=mailpit
KIRBY_SMTP_PORT=1025
KIRBY_SMTP_SECURITY=false
KIRBY_SMTP_AUTH=false
KIRBY_SMTP_USERNAME=
KIRBY_SMTP_PASSWORD=